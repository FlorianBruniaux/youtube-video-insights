---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout>
  <section class="page-heading" aria-labelledby="page-title">
    <p class="eyebrow">Your local YouTube research system</p>
    <h1 id="page-title">Build evidence, not another pile of tabs.</h1>
    <p>
      Search your transcript corpus, grow it with sources you approve, and turn the evidence into
      traceable research sessions.
    </p>
    <div class="hero-actions" aria-label="Primary actions">
      <a class="button" href="/search/">Search the corpus</a>
      <a class="button button-secondary" href="/research/new/">Start research</a>
    </div>
  </section>

  <section class="feature-grid" aria-label="How YT Insights works">
    <article class="feature-card">
      <span class="feature-number" aria-hidden="true">01</span>
      <h2>Check what you already know</h2>
      <p>Search timestamped passages across your existing local transcript catalogue first.</p>
    </article>
    <article class="feature-card">
      <span class="feature-number" aria-hidden="true">02</span>
      <h2>Close explicit gaps</h2>
      <p>Review freshness and coverage before deciding whether YouTube discovery is needed.</p>
    </article>
    <article class="feature-card">
      <span class="feature-number" aria-hidden="true">03</span>
      <h2>Export a traceable dossier</h2>
      <p>Keep evidence, decisions, source history, and outputs connected to the research session.</p>
    </article>
  </section>
</AppLayout>
