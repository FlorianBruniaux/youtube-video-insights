---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout>
  <div data-dashboard>
  <section class="page-heading" aria-labelledby="page-title">
    <p class="eyebrow">Your local YouTube research system</p>
    <h1 id="page-title">Build evidence, not another pile of tabs.</h1>
    <p>
      Search your transcript corpus, grow it with sources you approve, and turn the evidence into
      traceable research sessions.
    </p>
    <div class="hero-actions" aria-label="Primary actions">
      <a class="button" href="/search/">Search the corpus</a>
      <a class="button button-secondary" href="/research/new/">Start research</a>
      <a class="button button-secondary" href="/sources/">Add a YouTube source</a>
    </div>
  </section>

  <section class="dashboard-status panel" aria-labelledby="corpus-status-title">
    <div class="section-heading section-heading-inline">
      <div>
        <p class="eyebrow">Local system</p>
        <h2 id="corpus-status-title">Corpus status</h2>
      </div>
      <p data-dashboard-status role="status" aria-live="polite">Checking the local corpus…</p>
    </div>
    <div class="metric-grid" data-dashboard-metrics></div>
  </section>

  <section class="dashboard-panels" aria-label="Recent activity">
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Research</p>
        <h2>Recent sessions</h2>
      </div>
      <div data-dashboard-sessions>Loading recent research…</div>
    </article>
    <article class="panel">
      <div class="section-heading">
        <p class="eyebrow">Outputs</p>
        <h2>Recent exports</h2>
      </div>
      <div data-dashboard-exports>Loading recent exports…</div>
    </article>
  </section>
  </div>

  <script>
    import { attachDashboard } from "../lib/pages/dashboard";

    const root = document.querySelector<HTMLElement>("[data-dashboard]");
    if (root) void attachDashboard(root);
  </script>
</AppLayout>
