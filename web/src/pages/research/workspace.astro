---
import AcquisitionHistory from "../../components/AcquisitionHistory.astro";
import CandidateList from "../../components/CandidateList.astro";
import ContextGuide from "../../components/ContextGuide.astro";
import DecisionPanel from "../../components/DecisionPanel.astro";
import EvidencePanel from "../../components/EvidencePanel.astro";
import EventTimeline from "../../components/EventTimeline.astro";
import JobProgress from "../../components/JobProgress.astro";
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Research workspace" description="Review evidence and control one cumulative research session.">
  <div data-research-workspace>
    <p class="page-status research-status" data-research-status role="status" aria-live="polite"></p>
    <header class="page-heading page-heading-compact research-heading" data-research-heading>
      <p class="eyebrow" data-i18n="Cumulative research">Cumulative research</p>
      <h1 data-i18n="Loading research…">Loading research…</h1>
    </header>

    <ContextGuide
      title="One decision at a time"
      introduction="The workspace keeps local evidence, freshness, candidate discovery, and acquisition as separate reviewable steps."
      steps={[
        { title: "Inspect evidence", description: "Review matched passages, videos, missing queries, and freshness before deciding." },
        { title: "Confirm or refresh", description: "Finish when the corpus is sufficient, or request a bounded YouTube discovery." },
        { title: "Approve exact videos", description: "Select one to five candidates. Acquisition starts only after this second confirmation." },
      ]}
      tip="The event timeline records every state transition, so a paused session can be resumed safely."
    />

    <div class="research-layout">
      <EvidencePanel />
      <div class="research-controls" data-research-controls>
        <DecisionPanel />
        <JobProgress />
      </div>
      <CandidateList />
      <AcquisitionHistory />
      <EventTimeline />
    </div>
  </div>

  <script>
    import { attachResearchWorkspace } from "../../lib/pages/research-workspace";

    const root = document.querySelector<HTMLElement>("[data-research-workspace]");
    if (root) attachResearchWorkspace(root);
  </script>
</AppLayout>
