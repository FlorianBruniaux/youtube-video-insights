<section
  class="workflow-guide"
  aria-labelledby="workflow-guide-title"
  aria-label="How YT Insights works"
  data-i18n-aria-label="How YT Insights works"
>
  <div class="workflow-guide-heading">
    <div>
      <p class="eyebrow" data-i18n="The local-first workflow">The local-first workflow</p>
      <h2 id="workflow-guide-title" data-i18n="From YouTube to usable evidence">From YouTube to usable evidence</h2>
    </div>
    <p data-i18n="Start with the corpus you already own. Add new videos only when the current evidence is incomplete or stale.">
      Start with the corpus you already own. Add new videos only when the current evidence is
      incomplete or stale.
    </p>
  </div>

  <ol class="workflow-steps">
    <li>
      <span class="workflow-step-number">01</span>
      <p class="workflow-step-label" data-i18n="Collect">Collect</p>
      <h3 data-i18n="Feed the corpus">Feed the corpus</h3>
      <p data-i18n="Preview a channel, playlist, or video before approving the exact items to acquire.">Preview a channel, playlist, or video before approving the exact items to acquire.</p>
      <a href="/sources/" data-i18n="Add a source">Add a source</a>
    </li>
    <li>
      <span class="workflow-step-number">02</span>
      <p class="workflow-step-label" data-i18n="Search">Search</p>
      <h3 data-i18n="Reuse what you have">Reuse what you have</h3>
      <p data-i18n="Find timestamped transcript passages and open the original moment on YouTube.">Find timestamped transcript passages and open the original moment on YouTube.</p>
      <a href="/search/" data-i18n="Search the corpus">Search the corpus</a>
    </li>
    <li>
      <span class="workflow-step-number">03</span>
      <p class="workflow-step-label" data-i18n="Assess">Assess</p>
      <h3 data-i18n="Open a research session">Open a research session</h3>
      <p data-i18n="Measure coverage and freshness for a topic before contacting YouTube again.">Measure coverage and freshness for a topic before contacting YouTube again.</p>
      <a href="/research/new/" data-i18n="Start research">Start research</a>
    </li>
    <li>
      <span class="workflow-step-number">04</span>
      <p class="workflow-step-label" data-i18n="Decide">Decide</p>
      <h3 data-i18n="Grow deliberately">Grow deliberately</h3>
      <p data-i18n="Confirm sufficiency or approve one to five exact discovery candidates.">Confirm sufficiency or approve one to five exact discovery candidates.</p>
      <a href="/research/new/" data-i18n="Review the decision flow">Review the decision flow</a>
    </li>
    <li>
      <span class="workflow-step-number">05</span>
      <p class="workflow-step-label" data-i18n="Use">Use</p>
      <h3 data-i18n="Publish a dossier">Publish a dossier</h3>
      <p data-i18n="Open deterministic evidence exports, or query the corpus from an LLM through MCP.">Open deterministic evidence exports, or query the corpus from an LLM through MCP.</p>
      <a href="/exports/" data-i18n="Open exports">Open exports</a>
    </li>
  </ol>

  <div class="workflow-principle">
    <span data-i18n="LOCAL FIRST">LOCAL FIRST</span>
    <p data-i18n="No LLM is required to search, index, or export your transcript evidence.">No LLM is required to search, index, or export your transcript evidence.</p>
  </div>
</section>
