---
import { isNavigationLinkCurrent } from "../lib/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/", label: "Overview", match: "exact" },
  { href: "/research/new/", label: "Research", match: "exact" },
  { href: "/search/", label: "Search", match: "section" },
  { href: "/sources/", label: "Sources", match: "section" },
  { href: "/exports/", label: "Exports", match: "section" },
] as const;
---

<nav class="app-nav" aria-label="Primary navigation">
  <a class="brand" href="/" aria-label="YT Insights overview">
    <span class="brand-mark" aria-hidden="true">YT</span>
    <span>Insights</span>
  </a>

  <div class="nav-links">
    {
      links.map((link) => (
        <a
          class:list={[
            "nav-link",
            { "nav-link-active": isNavigationLinkCurrent(currentPath, link) },
          ]}
          href={link.href}
          aria-current={isNavigationLinkCurrent(currentPath, link) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <button
    class="theme-toggle"
    type="button"
    data-theme-toggle
    aria-pressed="true"
    aria-label="Use light theme"
  >
    <span class="theme-toggle-icon" aria-hidden="true">◐</span>
    <span data-theme-label>Light</span>
  </button>
</nav>
