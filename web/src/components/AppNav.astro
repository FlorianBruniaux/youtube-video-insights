---
import { isNavigationLinkCurrent } from "../lib/navigation";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/", label: "Overview", match: "exact" },
  { href: "/research/new/", label: "Research", match: "exact" },
  { href: "/search/", label: "Search", match: "section" },
  { href: "/sources/", label: "Sources", match: "section" },
  { href: "/exports/", label: "Exports", match: "section" },
] as const;
---

<nav class="app-nav" aria-label="Primary navigation" data-i18n-aria-label="Primary navigation">
  <a class="brand" href="/" aria-label="YT Insights overview" data-i18n-aria-label="YT Insights overview">
    <span class="brand-mark" aria-hidden="true">YT</span>
    <span>Insights</span>
  </a>

  <div class="nav-links">
    {
      links.map((link) => (
        <a
          class:list={[
            "nav-link",
            { "nav-link-active": isNavigationLinkCurrent(currentPath, link) },
          ]}
          href={link.href}
          aria-current={isNavigationLinkCurrent(currentPath, link) ? "page" : undefined}
          data-i18n={link.label}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="nav-controls">
    <div class="language-control" data-language-control role="group" aria-label="Display locale" data-i18n-aria-label="Display locale">
      <button class="language-option" type="button" data-language-option="en" aria-pressed="true">EN</button>
      <button class="language-option" type="button" data-language-option="fr" aria-pressed="false">FR</button>
    </div>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-pressed="true"
      aria-label="Use light theme"
    >
      <span class="theme-toggle-icon" aria-hidden="true">◐</span>
      <span data-theme-label>Light</span>
    </button>
  </div>
</nav>
