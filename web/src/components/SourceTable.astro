<section class="panel inventory-panel" aria-labelledby="source-inventory-title">
  <div class="section-heading section-heading-inline">
    <div>
      <p class="eyebrow" data-i18n="Local catalogue">Local catalogue</p>
      <h2 id="source-inventory-title" data-i18n="Source inventory">Source inventory</h2>
    </div>
    <p data-source-state role="status" aria-live="polite" data-i18n="Loading a bounded source page…">Loading a bounded source page…</p>
  </div>
  <div data-source-list aria-live="polite"></div>
  <nav class="pagination" aria-label="Source pages" data-i18n-aria-label="Source pages">
    <button class="button button-secondary" data-source-prev type="button" data-i18n="Previous">Previous</button>
    <span data-source-page-label data-i18n="Sources">Sources</span>
    <button class="button button-secondary" data-source-next type="button" data-i18n="Next">Next</button>
  </nav>
</section>
