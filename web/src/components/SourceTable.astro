<section class="panel inventory-panel" aria-labelledby="source-inventory-title">
  <div class="section-heading section-heading-inline">
    <div>
      <p class="eyebrow">Local catalogue</p>
      <h2 id="source-inventory-title">Source inventory</h2>
    </div>
    <p data-source-state role="status" aria-live="polite">Loading a bounded source page…</p>
  </div>
  <div data-source-list aria-live="polite"></div>
  <nav class="pagination" aria-label="Source pages">
    <button class="button button-secondary" data-source-prev type="button">Previous</button>
    <span data-source-page-label>Sources</span>
    <button class="button button-secondary" data-source-next type="button">Next</button>
  </nav>
</section>
