<section class="panel job-progress" data-job-progress hidden aria-labelledby="job-progress-title">
  <h2 id="job-progress-title" data-i18n="Background job">Background job</h2>
  <p data-job-message role="status" aria-live="polite"></p>
  <p class="job-identity"><span data-i18n="Job">Job</span> <code data-job-id></code></p>
  <button class="button button-secondary" data-job-continue type="button" hidden>
    <span data-i18n="Continue checking">Continue checking</span>
  </button>
  <button class="button button-secondary" data-job-retry-admission type="button" hidden>
    <span data-i18n="Retry admission with the same key">Retry admission with the same key</span>
  </button>
</section>
